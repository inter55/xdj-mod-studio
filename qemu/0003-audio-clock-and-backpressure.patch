+/*
+ * The clock the host can pay for.
+ *
+ * A host that cannot run the core at its modelled clock does not run it late
+ * and make it up: every slice the thread fails to finish is time the core
+ * never gets back, so the lag grows without bound and is paid back later as a
+ * burst of audio into the sink. Busy for a whole window and still behind means
+ * the clock is more than the host delivers, so drop it to what the host did
+ * deliver; once the thread has slack, climb back a few percent per window.
+ *
+ * Only the clock changes. EDMA3 and McASP are paced from @dsp_ns, which is
+ * virtual time, so the audio still leaves at 44.1 kHz -- a lower clock buys
+ * the host time by computing fewer cycles per emulated microsecond, it does
+ * not slow the output down.
+ */
+static void host_govern(CdjDspHost *h)
+{
+    int64_t wall = get_clock();
+    uint64_t cycle = c66x_get_cycle(h->core);
+    uint64_t busy, dc;
+    int64_t dw, dv;
+
+    if (!h->govern) {
+        return;
+    }
+    if (!h->gov_wall) {
+        h->gov_wall = wall;
+        h->gov_dsp_ns = h->dsp_ns;
+        h->gov_busy = h->busy_ns;
+        h->gov_cycle = cycle;
+        return;
+    }
+    dw = wall - h->gov_wall;
+    if (dw < GOV_WINDOW_NS) {
+        return;
+    }
+    dv = h->dsp_ns - h->gov_dsp_ns;
+    busy = h->busy_ns - h->gov_busy;
+    dc = cycle - h->gov_cycle;
+
+    if (busy * 10 >= (uint64_t)dw * 9 && dv * 100 < dw * 97) {
+        /* Saturated and still behind: the host delivers this much. */
+        uint64_t host_mhz = busy ? dc * 1000 / busy : h->mhz;
+        uint64_t mhz = MAX(host_mhz * 97 / 100, h->mhz_floor);
+
+        if (mhz + 2 < h->mhz) {
+            info_report("%s: host delivers %" PRIu64 " MHz; clock %" PRIu64
+                        " -> %" PRIu64 " MHz", h->name, host_mhz, h->mhz, mhz);
+            h->mhz = mhz;
+            h->cycles_per_chunk = mhz * CHUNK_NS / 1000;
+        }
+    } else if (busy * 5 < (uint64_t)dw * 4 && h->mhz < h->mhz_run) {
+        uint64_t mhz = MIN(h->mhz + h->mhz / 32 + 1, h->mhz_run);
+
+        if (mhz > h->mhz + 2) {
+            info_report("%s: slack; clock %" PRIu64 " -> %" PRIu64 " MHz",
+                        h->name, h->mhz, mhz);
+        }
+        h->mhz = mhz;
+        h->cycles_per_chunk = mhz * CHUNK_NS / 1000;
+    }
+    h->gov_wall = wall;
+    h->gov_dsp_ns = h->dsp_ns;
+    h->gov_busy = h->busy_ns;
+    h->gov_cycle = cycle;
+}
